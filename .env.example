# SatQuery AI — Environment Variables
SATQUERY_APP_NAME="SatQuery AI"
SATQUERY_DEBUG=false
SATQUERY_LOG_LEVEL=INFO
SATQUERY_LOG_JSON=true

# Database (PostgreSQL URL or defaults to SQLite)
# SATQUERY_DATABASE_URL=postgresql://user:password@localhost:5432/satquery

# Storage paths
# SATQUERY_STORAGE_ROOT=./storage
# SATQUERY_DEMO_DATA_ROOT=./data/demo
# SATQUERY_REPORTS_ROOT=./reports

# Optional fine-tuned model checkpoints
SATQUERY_ENABLE_LEARNED_MODELS=false
# SATQUERY_CHECKPOINT_DIR=./ml/checkpoints
