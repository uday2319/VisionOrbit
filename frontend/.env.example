# --- SatQuery AI frontend environment ---------------------------------------
# Copy to `.env.local` (git-ignored) and adjust. All frontend env vars MUST be
# prefixed with VITE_ to be exposed to the browser bundle (Vite convention).

# Base URL the API client targets. Leave blank to use the dev proxy (/api ->
# VITE_API_PROXY_TARGET, see vite.config.ts) or same-origin in production.
VITE_API_BASE_URL=

# When "true", the UI serves recorded real-analysis fixtures instead of calling
# the backend. Useful for offline demos and CI. When "false" (or unset), the
# client calls the live API and only falls back to fixtures if it is unreachable.
VITE_USE_FIXTURES=true

# Dev-server proxy target for /api (used by `npm run dev` only).
VITE_API_PROXY_TARGET=http://localhost:8000
